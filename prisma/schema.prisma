// App state only. Twin knowledge (profile, trades, insights, milestones, chat facts)
// lives in Walrus Memory — see lib/memory.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  // Normalized 0x-prefixed 64-hex Sui address.
  address   String   @id
  createdAt DateTime @default(now())
  lastLogin DateTime @default(now())
}

// Single-use sign-in challenge. The exact message is stored so verification
// checks the signature against the bytes the wallet was shown.
model AuthNonce {
  nonce     String    @id
  address   String
  message   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([address])
}

// Coin metadata cache (symbol/decimals), filled from Tatum GraphQL coinMetadata.
model CoinInfo {
  coinType  String   @id
  symbol    String?
  name      String?
  decimals  Int?
  fetchedAt DateTime @default(now())
}

// Tatum OHLCV results per (symbol, candle). usd = null records "Tatum has no usable
// price", so we never pay 50 credits twice for the same miss.
model PriceCache {
  symbol      String
  candleStart DateTime
  usd         Float?
  fetchedAt   DateTime @default(now())

  @@id([symbol, candleStart])
}

// A wallet's classified, USD-valued on-chain activity (one row per transaction).
model Activity {
  address    String
  digest     String
  checkpoint Int
  timestamp  DateTime
  kind       String
  usdValue   Float?
  // JSON-encoded ValuedActivity (legs, gas, counterparty, NFT types).
  data       String

  @@id([address, digest])
  @@index([address, timestamp])
}

// Incremental sync cursor per wallet: re-syncs only ask Tatum for newer checkpoints.
model SyncState {
  address        String    @id
  lastCheckpoint Int?
  lastDigest     String?
  historyFromMs  DateTime?
  lastSyncedAt   DateTime?
}

// One row per sync attempt; the /sync page polls the latest run for progress.
model SyncRun {
  id         String    @id @default(cuid())
  address    String
  status     String // running | done | failed
  stage      String // history | analyze | twin | memory | done
  // JSON progress counters shown in the UI.
  progress   String    @default("{}")
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([address, startedAt])
}

// Ledger of every memory we asked Walrus Memory to store. The (address, key) pair
// makes writes idempotent: a trade digest is never remembered twice.
model MemoryWrite {
  address   String
  // e.g. "trade:<digest>", "profile:<runId>", "chat:<hash>"
  key       String
  type      String
  text      String
  backend   String // walrus | local
  jobId     String?
  status    String // pending | done | failed
  error     String?
  createdAt DateTime @default(now())

  @@id([address, key])
  @@index([address, status])
}

// Local stand-in for Walrus Memory, used only while MEMWAL_* credentials are missing.
model LocalMemory {
  id        Int      @id @default(autoincrement())
  namespace String
  text      String
  createdAt DateTime @default(now())

  @@index([namespace, createdAt])
}
