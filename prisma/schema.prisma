// App state only. Twin knowledge (profile, trades, insights, milestones, chat facts)
// lives in Walrus Memory — see lib/memory.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  // Normalized 0x-prefixed 64-hex Sui address.
  address   String   @id
  createdAt DateTime @default(now())
  lastLogin DateTime @default(now())
}

// Single-use sign-in challenge. The exact message is stored so verification
// checks the signature against the bytes the wallet was shown.
model AuthNonce {
  nonce     String    @id
  address   String
  message   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([address])
}

// Coin metadata cache (symbol/decimals), filled from Tatum GraphQL coinMetadata.
model CoinInfo {
  coinType  String   @id
  symbol    String?
  name      String?
  decimals  Int?
  fetchedAt DateTime @default(now())
}

// Tatum OHLCV results per (symbol, candle). usd = null records "Tatum has no usable
// price", so we never pay 50 credits twice for the same miss.
model PriceCache {
  symbol      String
  candleStart DateTime
  usd         Float?
  fetchedAt   DateTime @default(now())

  @@id([symbol, candleStart])
}

// A wallet's classified, USD-valued on-chain activity (one row per transaction).
model Activity {
  address    String
  digest     String
  checkpoint Int
  timestamp  DateTime
  kind       String
  usdValue   Float?
  // JSON-encoded ValuedActivity (legs, gas, counterparty, NFT types).
  data       String

  @@id([address, digest])
  @@index([address, timestamp])
}

// Incremental sync cursor per wallet: re-syncs only ask Tatum for newer checkpoints.
model SyncState {
  address        String    @id
  lastCheckpoint Int?
  lastDigest     String?
  historyFromMs  DateTime?
  lastSyncedAt   DateTime?
}

// One row per sync attempt; the /sync page polls the latest run for progress.
model SyncRun {
  id         String    @id @default(cuid())
  address    String
  status     String // running | done | failed
  stage      String // history | analyze | twin | memory | done
  // JSON progress counters shown in the UI.
  progress   String    @default("{}")
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([address, startedAt])
}

// Ledger of every memory we asked Walrus Memory to store. The (address, key) pair
// makes writes idempotent: a trade digest is never remembered twice.
model MemoryWrite {
  address   String
  // e.g. "trade:<digest>", "profile:<runId>", "chat:<hash>"
  key       String
  type      String
  text      String
  backend   String // walrus | local
  jobId     String?
  status    String // pending | done | failed
  error     String?
  createdAt DateTime @default(now())

  @@id([address, key])
  @@index([address, status])
}

// Local stand-in for Walrus Memory, used only while MEMWAL_* credentials are missing.
model LocalMemory {
  id        Int      @id @default(autoincrement())
  namespace String
  text      String
  createdAt DateTime @default(now())

  @@index([namespace, createdAt])
}

// The Wrapped card's one-liner, regenerated only when the wallet's activity changes.
model WrappedLine {
  address   String   @id
  // Activity fingerprint (count + newest digest) the line was written for.
  dataKey   String
  line      String
  createdAt DateTime @default(now())
}

// Opt-in: a row here means the owner chose to publish their twin. Deleting it
// (unpublish) removes the twin from the leaderboard and public chat immediately.
model PublicTwin {
  address     String   @id
  publishedAt DateTime @default(now())
}

// Cached leaderboard numbers for published twins (recomputed after syncs/publishing).
model LeaderboardEntry {
  address        String   @id
  swaps          Int
  closedTrades   Int
  winRate        Float?
  realizedPnlUsd Float
  volumeUsd      Float
  // Simulated return of a $1,000 paper copy portfolio over the twin's history (step 8).
  copyReturnPct  Float?
  favoriteToken  String?
  headline       String?
  updatedAt      DateTime @updatedAt
}

// A follower paper-copying a published twin. SIMULATED: no real funds or trades.
model Follow {
  id             String    @id @default(cuid())
  follower       String
  leader         String
  active         Boolean   @default(true)
  startingUsd    Float     @default(1000)
  // JSON PaperState (cash, positions, last prices, totals) — see lib/copy/engine.ts
  state          String
  // JSON leader balances in units, kept current from Tatum snapshots + new activity
  leaderBalances String
  // Only leader transactions after this checkpoint are copied.
  lastCheckpoint Int
  startedAt      DateTime  @default(now())
  lastPolledAt   DateTime?

  @@unique([follower, leader])
  @@index([leader])
}

// One row per leader swap considered for a follow (filled or skipped, with reason).
model PaperTrade {
  id          String   @id @default(cuid())
  followId    String
  digest      String
  timestamp   DateTime
  status      String // filled | skipped
  reason      String?
  soldCoin    String?
  soldAmount  Float?
  boughtCoin  String?
  boughtAmount Float?
  volumeUsd   Float?
  feeUsd      Float?

  @@unique([followId, digest])
  @@index([followId, timestamp])
}

// ── Agent access (MCP) ──────────────────────────────────────────────────────
// Every secret below is stored only as a SHA-256 hash.

// An OAuth client: registered through DCR (id = random), or a CIMD client whose
// id is the HTTPS URL of its metadata document (cached here).
model OAuthClient {
  id           String   @id
  name         String
  // JSON string[] of exact redirect URIs
  redirectUris String
  logoUri      String?
  clientUri    String?
  // dcr | cimd
  source       String
  fetchedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
}

// One wallet's consent to one client: a "connected app". Revoking it kills all its tokens.
model OAuthGrant {
  id         String    @id @default(cuid())
  clientId   String
  clientName String
  address    String
  demo       Boolean   @default(false)
  // Space-separated scopes
  scopes     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([address])
}

// Single-use authorization code (PKCE S256), valid for a minute.
model OAuthCode {
  codeHash      String    @id
  grantId       String
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String
  scopes        String
  expiresAt     DateTime
  usedAt        DateTime?
}

model OAuthToken {
  tokenHash String    @id
  // access | refresh
  kind      String
  grantId   String
  scopes    String
  resource  String
  expiresAt DateTime
  revokedAt DateTime?
  // Refresh tokens: set once rotated. Presenting a rotated token again revokes the grant.
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([grantId])
}

// Personal API key for scripts and headless agents.
model ApiKey {
  id            String    @id @default(cuid())
  name          String
  // First characters of the key, for recognizing it in the list (never enough to use it).
  displayPrefix String
  keyHash       String    @unique
  address       String
  scopes        String
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([address])
}
