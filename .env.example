# Copy to .env.local and fill in. Never commit .env.local.

# --- App ---
DATABASE_URL="file:./prisma/dev.db"
# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""
# mainnet | testnet (used by the wallet UI and server-side Sui reads)
NEXT_PUBLIC_SUI_NETWORK="mainnet"

# --- Tatum (Sui gateway: GraphQL https://sui-mainnet.gateway.tatum.io/graphql) ---
# Get a key at https://dashboard.tatum.io
TATUM_API_KEY=""
# History transport: grpc (~9 months of address history, needs the key) | graphql (~90 days)
TATUM_SUI_HISTORY_SOURCE="grpc"

# --- Walrus Memory (MemWal) --- dashboard: https://memory.walrus.xyz
# Delegate private key (hex or suiprivkey1...) and MemWalAccount object id.
MEMWAL_PRIVATE_KEY=""
MEMWAL_ACCOUNT_ID=""
# Mainnet relayer (hackathon requires mainnet). Staging: https://relayer-staging.memory.walrus.xyz
MEMWAL_SERVER_URL="https://relayer.memory.walrus.xyz"

# --- LLM ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Only needed if your API key is not scoped to one workspace (console.anthropic.com → Workspaces)
ANTHROPIC_WORKSPACE_ID=""
